on-arrival: {!
// set up the infrastructure
Q.pol_formed = 1;
Q.parties.push('pol');

Q.workers_pol = 10;
Q.workers_po -= 3;
Q.new_middle_pol = 1;
Q.old_middle_pol = 0;
Q.rural_pol = 0;
Q.unemployed_pol = 2;
Q.catholics_pol = 0;

Q.workers_other -= 5;

if (Q.unions_independent) {
    Q.workers_sapd += 8;
}

// update all records
Q.pol_r = 0;
Q.old_pol_r = 0;
for (var record of Q.election_records) {
    record['pol'] = 0;
}
for (var record of Q.party_support_records) {
    record['pol'] = 0;
}
!}
