title: Election
on-arrival: {!
// 1. Calculate total support for each party based on class demographics
var total_support = 0;
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) {
            party_support += Q[c] * Q[c + '_' + party];
        } else {
            party_support += Q[c] * Q[c + '_' + party + '_normalized'];
        }
    }
    Q[party + '_support'] = party_support;
    total_support += party_support;
}

// 2. Normalize votes to sum to 100%
var raw_votes = {};
for (var party of Q.parties) {
    raw_votes[party] = (Q[party + '_support'] / total_support) * 100;
}

var total_votes = 0;
for (var party of Q.parties) {
    Q[party + '_votes_int'] = Math.round(raw_votes[party]);
    total_votes += Q[party + '_votes_int'];
}

// Adjust rounding leftovers
var leftover = 100 - total_votes;
if (leftover !== 0) {
    var remainders = Q.parties.map(party => ({
        party: party,
        remainder: raw_votes[party] - Q[party + '_votes_int']
    }));
    remainders.sort((a, b) => leftover > 0 ? b.remainder - a.remainder : a.remainder - b.remainder);
    for (var i = 0; i < Math.abs(leftover); i++) {
        var party = remainders[i % remainders.length].party;
        Q[party + '_votes_int'] += leftover > 0 ? 1 : -1;
    }
}

// Store display and normalized percentages
for (var party of Q.parties) {
    Q[party + '_votes_disp'] = Q[party + '_votes_int'] + '%';
    Q[party + '_normalized'] = Q[party + '_votes_int'] / 100;
}

// 3. Seat allocation using bias factors (no D'Hondt)
var totalSeats = 460;

// Reset seat counts
for (var party of Q.parties) {
    Q[party + '_r'] = 0;
}

// -----------------------------
// Handle special list formations
// -----------------------------
var effectiveParties = [...Q.parties];
var mergedVotes = {};
var mergedMap = {}; // merged bloc -> its members

if (Q.raz_lew_list_formed === 1) {
    effectiveParties = effectiveParties.filter(p => p !== "raz" && p !== "lew");
    effectiveParties.push("raz_lew");
    mergedMap["raz_lew"] = ["raz","lew"];
    mergedVotes["raz_lew"] = Q["raz_support"] + Q["lew_support"];
}
if (Q.pol_psl_list_formed === 1) {
    effectiveParties = effectiveParties.filter(p => p !== "pol" && p !== "psl");
    effectiveParties.push("pol_psl");
    mergedMap["pol_psl"] = ["pol","psl"];
    mergedVotes["pol_psl"] = Q["pol_support"] + Q["psl_support"];
}

// -----------------------------
// Rank parties by support (merged blocs included)
// -----------------------------
var rankedParties = [...effectiveParties].sort((a, b) => {
    let sa = mergedVotes[a] !== undefined ? mergedVotes[a] : Q[a + "_support"];
    let sb = mergedVotes[b] !== undefined ? mergedVotes[b] : Q[b + "_support"];
    return sb - sa;
});

// -----------------------------
// Assign bias factors by rank
// -----------------------------
var biasMap = {};
for (var i = 0; i < rankedParties.length; i++) {
    var party = rankedParties[i];
    if (i === 0) biasMap[party] = 1.15;   // largest bonus
    else if (i === 1) biasMap[party] = 0.95;
    else if (i === 2) biasMap[party] = 0.85;
    else biasMap[party] = 0.80;
}

// -----------------------------
// Compute biased vote totals
// -----------------------------
var biasedTotals = {};
var totalBiased = 0;
for (var party of effectiveParties) {
    let baseVotes = mergedVotes[party] !== undefined ? mergedVotes[party] : Q[party + "_support"];
    let biased = baseVotes * biasMap[party];
    biasedTotals[party] = biased;
    totalBiased += biased;
}

// -----------------------------
// Distribute seats proportionally by biased totals
// -----------------------------
var seatAllocs = {};
var seatSum = 0;
for (var party of effectiveParties) {
    let seats = Math.floor((biasedTotals[party] / totalBiased) * totalSeats);
    seatAllocs[party] = seats;
    seatSum += seats;
}

// fix rounding leftovers
var leftoverSeats = totalSeats - seatSum;
if (leftoverSeats !== 0) {
    var remainders = effectiveParties.map(p => {
        let exact = (biasedTotals[p] / totalBiased) * totalSeats;
        return { party: p, frac: exact - seatAllocs[p] };
    }).sort((a,b) => b.frac - a.frac);
    for (var i=0; i<leftoverSeats; i++) {
        seatAllocs[remainders[i % remainders.length].party]++;
    }
}

// -----------------------------
// Split merged blocs back to members
// -----------------------------
for (var party of effectiveParties) {
    if (mergedMap[party]) {
        let members = mergedMap[party];
        let blocVotes = members.map(m => Q[m + "_support"]);
        let blocTotal = blocVotes.reduce((a,b)=>a+b,0);

        let assigned = 0;
        for (var j=0;j<members.length;j++) {
            let m = members[j];
            let exact = (Q[m + "_support"]/blocTotal) * seatAllocs[party];
            let s = Math.floor(exact);
            Q[m + "_r"] = s;
            assigned += s;
        }
        // leftover seats inside bloc
        var blocLeftover = seatAllocs[party] - assigned;
        if (blocLeftover > 0) {
            let remainders = members.map(m => {
                let exact = (Q[m + "_support"]/blocTotal) * seatAllocs[party];
                return { party: m, frac: exact - Q[m + "_r"] };
            }).sort((a,b) => b.frac - a.frac);
            for (var k=0; k<blocLeftover; k++) {
                Q[remainders[k % remainders.length].party + "_r"]++;
            }
        }
    } else {
        Q[party + "_r"] = seatAllocs[party];
    }
}

// Optional: store bias info for debugging
for (var party of effectiveParties) {
    Q[party + "_bias_factor"] = biasMap[party];
}
!}
go-to: jumpScene
