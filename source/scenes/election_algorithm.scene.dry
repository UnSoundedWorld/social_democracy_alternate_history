title: Election
on-arrival: {!
// 1. Calculate total support for each party based on class demographics
var total_support = 0;
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) {
            party_support += Q[c] * Q[c + '_' + party];
        } else {
            party_support += Q[c] * Q[c + '_' + party + '_normalized'];
        }
    }
    Q[party + '_support'] = party_support;
    total_support += party_support;
}

// 2. Normalize votes to sum to 100%
var raw_votes = {};
for (var party of Q.parties) {
    raw_votes[party] = (Q[party + '_support'] / total_support) * 100;
}

var total_votes = 0;
for (var party of Q.parties) {
    Q[party + '_votes_int'] = Math.round(raw_votes[party]);
    total_votes += Q[party + '_votes_int'];
}

// Adjust leftover
var leftover = 100 - total_votes;
if (leftover !== 0) {
    var remainders = Q.parties.map(party => ({
        party: party,
        remainder: raw_votes[party] - Q[party + '_votes_int']
    }));
    remainders.sort((a, b) => leftover > 0 ? b.remainder - a.remainder : a.remainder - b.remainder);
    for (var i = 0; i < Math.abs(leftover); i++) {
        var party = remainders[i % remainders.length].party;
        Q[party + '_votes_int'] += leftover > 0 ? 1 : -1;
    }
}

// Store display and normalized
for (var party of Q.parties) {
    Q[party + '_votes_disp'] = Q[party + '_votes_int'] + '%';
    Q[party + '_normalized'] = Q[party + '_votes_int'] / 100;
}

// 3. D'Hondt seat allocation with graduated bias
var totalSeats = 460;

// Initialize seat counts
for (var party of Q.parties) {
    Q[party + '_r'] = 0;
}

// 🔥 Sort parties by support to assign ranks
var rankedParties = [...Q.parties].sort((a, b) => Q[b + '_support'] - Q[a + '_support']);

// Assign bias factors based on rank
var biasMap = {};
for (var i = 0; i < rankedParties.length; i++) {
    var party = rankedParties[i];
    if (i === 0) biasMap[party] = 1.15; // Biggest party gets bonus
    else if (i === 1) biasMap[party] = 0.95; // Second party slight penalty
    else if (i === 2) biasMap[party] = 0.85; // Third party more penalty
    else biasMap[party] = 0.80; // All smaller parties penalized more
}

// Optional: Store bias info for debugging or display
for (var party of Q.parties) {
    Q[party + '_bias_factor'] = biasMap[party];
}

// D’Hondt allocation with bias
for (var seat = 0; seat < totalSeats; seat++) {
    var quotients = Q.parties.map(function(party) {
        var seatsAlready = Q[party + '_r'];
        var baseVotes = Q[party + '_support'];
        var biasedVotes = baseVotes * biasMap[party];
        return {
            party: party,
            quotient: biasedVotes / (seatsAlready + 1)
        };
    });

    quotients.sort((a, b) => b.quotient - a.quotient);
    var winner = quotients[0].party;
    Q[winner + '_r'] += 1;
}
!}
go-to: jumpScene

