title: Election
on-arrival: {!
// 1. Calculate total support for each party based on class demographics
var total_support = 0;
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) {
            party_support += Q[c] * Q[c + '_' + party];
        } else {
            party_support += Q[c] * Q[c + '_' + party + '_normalized'];
        }
    }
    Q[party + '_support'] = party_support;
    total_support += party_support;
}

// 2. Normalize votes so they sum exactly to 100% (rounded integers)
// Calculate raw vote percentages
var raw_votes = {};
for (var party of Q.parties) {
    raw_votes[party] = (Q[party + '_support'] / total_support) * 100;
}

// Initial rounding to integers
var total_votes = 0;
for (var party of Q.parties) {
    Q[party + '_votes_int'] = Math.round(raw_votes[party]);
    total_votes += Q[party + '_votes_int'];
}

// Adjust leftover to make total exactly 100
var leftover = 100 - total_votes;
if (leftover !== 0) {
    // Calculate fractional remainders
    var remainders = Q.parties.map(party => ({
        party: party,
        remainder: raw_votes[party] - Q[party + '_votes_int']
    }));

    // Sort by remainder depending on leftover sign
    remainders.sort((a, b) => leftover > 0 ? b.remainder - a.remainder : a.remainder - b.remainder);

    for (var i = 0; i < Math.abs(leftover); i++) {
        var party = remainders[i % remainders.length].party;
        Q[party + '_votes_int'] += leftover > 0 ? 1 : -1;
    }
}

// 3. Store final vote percentage display and normalized fractions
for (var party of Q.parties) {
    Q[party + '_votes_disp'] = Q[party + '_votes_int'] + '%';
    Q[party + '_normalized'] = Q[party + '_votes_int'] / 100;
}

// 4. D'Hondt seat allocation
var totalSeats = 100; // Change this to the number of seats to allocate

// Initialize seat counts
for (var party of Q.parties) {
    Q[party + '_r'] = 0;
}

// Allocate seats using D'Hondt method
for (var seat = 0; seat < totalSeats; seat++) {
    var quotients = Q.parties.map(function(party) {
        var seatsAlready = Q[party + '_r'];
        var votes = Q[party + '_support']; // Use raw support, not rounded votes
        return {
            party: party,
            quotient: votes / (seatsAlready + 1)
        };
    });

    quotients.sort(function(a, b) {
        return b.quotient - a.quotient;
    });

    var winner = quotients[0].party;
    Q[winner + '_r'] += 1;
}
!}
go-to: jumpScene
